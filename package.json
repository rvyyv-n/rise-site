{
  "name": "rise-site",
  "private": true,
  "version": "0.0.0",
  "description": "The Rise marketing site. Static HTML and CSS, built by Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/release.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "check:headers": "node scripts/check-headers.mjs",
    "shot": "node scripts/shot.mjs",
    "check:looks": "node scripts/check-looks.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "demo:markup": "node scripts/demo-markup.mjs",
    "audit": "node scripts/audit.mjs",
    "fonts": "node scripts/fonts.mjs"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
