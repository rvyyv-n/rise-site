    "shot": "node scripts/shot.mjs",
    "check:looks": "node scripts/check-looks.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.146.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
